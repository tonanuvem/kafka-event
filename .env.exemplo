# ============================================================
# Configuracao do LAB. Copie para .env (o ./lab.sh configurar
# faz isso por voce) e preencha o webhook do Teams.
# ============================================================

# Seu nome. Vai no titulo do card: o canal da turma e compartilhado,
# entao sem isso as mensagens de 30 alunos viram sopa.
ALUNO=aluno-sem-nome

# URL gerada pelo fluxo do Power Automate (app Workflows do Teams).
# Trate como SEGREDO: quem tem a URL posta no canal.
# Enquanto estiver vazio, o notificador imprime o card no log em vez
# de enviar -- da para fazer o lab inteiro sem o Teams configurado.
TEAMS_WEBHOOK=

# IP publico da VM. O ./lab.sh preenche sozinho.
IP_PUBLICO=localhost

# --- Ajustes do modulo de IA ---
# Acima deste score de similaridade, a categoria vem do catalogo e o
# LLM nem e chamado. Baixar = mais chamadas de IA = mais lento.
LIMIAR_CATALOGO=0.80
# Quantas compras duvidosas vao juntas em uma chamada do LLM.
LOTE_IA=5
OLLAMA_MODELO=gemma:2b

# --- Armazenamento de objetos (API S3) ---
S3_CHAVE=labfiap
S3_SEGREDO=labfiap123
